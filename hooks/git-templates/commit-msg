#!/usr/bin/env bash
# Global commit-msg adapter. The only layer that can see the final message,
# including messages built with HEREDOC or an editor.
set -uo pipefail

PROTOCOL_LIB="${PROTOCOL_LIB:-$HOME/.agents/lib/rules.sh}"
[ -f "$PROTOCOL_LIB" ] || { echo "ERROR: protocol rule engine missing at $PROTOCOL_LIB" >&2; exit 1; }
# shellcheck source=/dev/null
. "$PROTOCOL_LIB"

protocol_check_msg "$1" || exit 1
exit 0
