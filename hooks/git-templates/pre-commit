#!/usr/bin/env bash
# Global Git Pre-Commit Hook Template
# Auto-applied to new repos via git config init.templateDir
# Checks: secrets, PII, email, conventional commits, spec update enforcement
set -euo pipefail

# === 1. Email Verification ===
CURRENT_EMAIL=$(git config user.email 2>/dev/null || true)
case "$CURRENT_EMAIL" in
  *noreply.github.com) ;; # OK
  "")
    echo "ERROR: git user.email not set."
    echo "Run: git config user.email 'BasilSuhail@users.noreply.github.com'"
    exit 1
    ;;
  *)
    echo "ERROR: git user.email is '$CURRENT_EMAIL'"
    echo "Must use noreply.github.com email."
    echo "Run: git config user.email 'BasilSuhail@users.noreply.github.com'"
    exit 1
    ;;
esac

# === 2. PII / Secret Scanning (lightweight) ===
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$STAGED_FILES" ]; then
  # Check for common secret patterns
  SECRETS_FOUND=$(echo "$STAGED_FILES" | xargs grep -lE \
    '(AKIA[0-9A-Z]{16}|sk-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{36}|password\s*=\s*["\x27][^"\x27]{8,}|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+)' \
    2>/dev/null || true)
  if [ -n "$SECRETS_FOUND" ]; then
    echo "ERROR: Possible secrets or IP addresses detected in:"
    echo "$SECRETS_FOUND"
    echo "Remove secrets before committing. Use .env files instead."
    exit 1
  fi

  # Check for .env files being committed
  ENV_FILES=$(echo "$STAGED_FILES" | grep -E '\.env($|\.)' || true)
  if [ -n "$ENV_FILES" ]; then
    echo "ERROR: .env file staged for commit: $ENV_FILES"
    echo "Environment files must never be committed."
    exit 1
  fi

  # Check for Co-Authored-By in commit template
  # (This runs before the commit message is finalized, so check staged files for it)
fi

# === 3. Gitleaks (if installed) ===
if command -v gitleaks &>/dev/null; then
  gitleaks protect --staged --no-banner 2>/dev/null || {
    echo "ERROR: Gitleaks detected secrets in staged files."
    echo "Review and remove secrets before committing."
    exit 1
  }
fi

# === 4. Source + Spec Sync Check ===
# If source files changed, warn if no spec/doc file is also staged
SRC_CHANGED=$(echo "$STAGED_FILES" | grep -E '^(src/|lib/|app/|backend/|frontend/)' || true)
SPEC_CHANGED=$(echo "$STAGED_FILES" | grep -E '(CLAUDE\.md|AGENTS\.md|docs/|DESIGN\.md|CHANGELOG\.md|README\.md)' || true)
if [ -n "$SRC_CHANGED" ] && [ -z "$SPEC_CHANGED" ]; then
  # Advisory only — not all source changes need doc updates
  echo "NOTE: Source files changed but no spec/doc files updated."
  echo "Consider updating docs if behavior changed."
fi

# === 5. Python linting (if ruff available and .py files staged) ===
PY_FILES=$(echo "$STAGED_FILES" | grep '\.py$' || true)
if [ -n "$PY_FILES" ] && command -v ruff &>/dev/null; then
  echo "$PY_FILES" | xargs ruff check --select E,W,F --quiet 2>/dev/null || {
    echo "WARNING: Ruff found issues in Python files (non-blocking)."
  }
fi

exit 0
