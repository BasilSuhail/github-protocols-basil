#!/usr/bin/env bash
# Global pre-push adapter. git passes <remote-name> <remote-url>, ref updates on stdin.
set -uo pipefail

PROTOCOL_LIB="${PROTOCOL_LIB:-$HOME/.agents/lib/rules.sh}"
[ -f "$PROTOCOL_LIB" ] || { echo "ERROR: protocol rule engine missing at $PROTOCOL_LIB" >&2; exit 1; }
# shellcheck source=/dev/null
. "$PROTOCOL_LIB"

protocol_check_refs "${2:-}" || exit 1
exit 0
