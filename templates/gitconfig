# Global Git Config Template
# Copy relevant sections to ~/.gitconfig

[user]
	name = Basil Suhail
	email = BasilSuhail@users.noreply.github.com

[init]
	templateDir = ~/.git-templates

[push]
	default = current
	autoSetupRemote = true

[pull]
	rebase = true

[commit]
	cleanup = strip

[branch]
	sort = -committerdate

